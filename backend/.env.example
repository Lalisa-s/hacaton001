APP_NAME="Family Banking API"
DATABASE_URL=sqlite:///./family_banking.db

# Demo data only. No real authentication; header X-Demo-User-Id can change the actor.
DEMO_MODE=true
DEMO_USER_ID=10

# JSON array. Set the actual uni-app H5 page origin (scheme + host + port).
# The localhost values below are inherited examples; confirm the real origin
# with the frontend developer. Do not include a path or trailing slash.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
